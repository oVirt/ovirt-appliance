<?xml version="1.0" encoding="utf-8"?>

<image schemaversion="8.0" name="ovirt-engine-appliance">
    <description type="system">
        <author>oVirt Developers</author>
        <contact>devel@ovirt.org</contact>
        <specification>oVirt Appliance - CentOS Stream 9</specification>
    </description>
    <include from="file://kiwi/default.xml"/>
    <repository sourcetype="metalink">
        <source path="https://mirrors.centos.org/metalink?repo=centos-baseos-9-stream&amp;arch=x86_64&amp;protocol=https,http"/>
    </repository>
    <repository sourcetype="metalink">
        <source path="https://mirrors.centos.org/metalink?repo=centos-appstream-9-stream&amp;arch=x86_64&amp;protocol=https,http"/>
    </repository>
    <repository sourcetype="metalink">
        <source path="https://mirrors.centos.org/metalink?repo=centos-extras-sig-extras-common-9-stream&amp;arch=$basearch&amp;protocol=https,http"/>
    </repository>
    <repository sourcetype="metalink">
        <source path="https://mirrors.fedoraproject.org/metalink?repo=epel-9&amp;arch=x86_64"/>
    </repository>
    <!-- oVirt Master Snapshot -->
    <repository alias="ovirt-master-snapshot" profiles="snapshot">
        <source path="https://resources.ovirt.org/pub/ovirt-master-snapshot/rpm/el9s/x86_64/"/>
    </repository>
    <packages type="image" profiles="snapshot">
        <package name="ovirt-release-master"/>
    </packages>
    <!-- CBS Testing -->
    <repository alias="centos-extras" profiles="cbs-testing">
        <source path="https://buildlogs.centos.org/centos/9-stream/extras/x86_64/extras-common/"/>
    </repository>
    <packages type="image" profiles="cbs-testing">
        <package name="centos-release-ovirt45-testing"/>
    </packages>
    <!-- CBS Release -->
    <packages type="image" profiles="cbs-release">
        <package name="centos-release-ovirt45"/>
    </packages>
    <include from="file://kiwi/packages.xml"/>
</image>
